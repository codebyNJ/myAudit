# Isolation image for the feature agent: the workspace is bind-mounted at /work
# and `claude` runs inside here, so a misbehaving command is confined to a
# throwaway container. Auth is via CLAUDE_CODE_OAUTH_TOKEN (from `claude
# setup-token`) since the host keychain isn't reachable.
FROM node:22-alpine

RUN apk add --no-cache git bash \
 && npm install -g @anthropic-ai/claude-code

WORKDIR /work

# Invoked as: docker run --rm -v <ws>:/work -w /work -e CLAUDE_CODE_OAUTH_TOKEN \
#   myintern-sandbox claude -p "<task>" --output-format json --add-dir /work ...
ENTRYPOINT []
