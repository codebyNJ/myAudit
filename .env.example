# Copy to .env and fill in. .env is gitignored — never commit real values.

# Path to the fullstack template the engine scaffolds from (required for real runs).
TEMPLATE_PATH=/path/to/ankor-fullstack-template

# Model for the Claude Code feature agent (optional; defaults to Haiku).
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Set REAL_CLAUDE=1 to drive feature nodes with the real Claude Code agent
# (subscription-authed — run `claude` once to log in). Unset = $0 stub agent.
# REAL_CLAUDE=1

# Optional container isolation for the agent (blast-radius sandbox).
# Build the image once:  docker build -f Dockerfile.sandbox -t myintern-sandbox .
# Generate a headless token once:  claude setup-token   (needs a Claude subscription)
# Then:
# AGENT_ISOLATE=1
# CLAUDE_CODE_OAUTH_TOKEN=<token from `claude setup-token`>
# AGENT_IMAGE=myintern-sandbox
