# myAudit config — all optional. Copy to .env to override defaults.
# The agent uses your Claude Code CLI auth; there are no API keys here.

# SQLite database file (default: ./myaudit.db)
# MYAUDIT_DB=myaudit.db

# Claude model for agent nodes (default: claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Milliseconds between processed nodes in the run loop
# RUN_PACE_MS=500

# Bounded concurrency for agent nodes (default: 2)
# MAX_CONCURRENT_CLAUDE=2
