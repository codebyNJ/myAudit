# myAudit config — all optional. Copy to .env to override defaults.
# The agent uses your local CLI auth (Claude Code or OpenCode); no API keys stored here.

# SQLite database file (default: ./myaudit.db)
# MYAUDIT_DB=myaudit.db

# HTTP listen port (default: 7788)
# PORT=7788

# Use the real agent instead of the $0 stub (make run sets this)
# REAL_CLAUDE=1

# Active agent provider: claude (default) or opencode
# AGENT_PROVIDER=opencode

# Claude model override. If set, wins over the in-app Settings model picker.
# CLAUDE_MODEL=claude-sonnet-5

# Path to the claude CLI binary (default: claude on PATH)
# CLAUDE_BIN=claude

# OpenCode model (provider/model). Wins over in-app Settings when set.
# OPENCODE_MODEL=anthropic/claude-haiku-4-5

# Path to the opencode CLI binary (default: opencode on PATH)
# OPENCODE_BIN=opencode

# Max concurrent Claude agent processes (default: 1)
# MAX_CONCURRENT_CLAUDE=2

# Milliseconds between processed nodes in the run loop
# RUN_PACE_MS=500

# Run each agent inside a container (blast-radius isolation). Needs the image.
# AGENT_ISOLATE=1
# AGENT_IMAGE=myaudit-sandbox
