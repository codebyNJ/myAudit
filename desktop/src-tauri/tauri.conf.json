{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myAudit",
  "version": "0.1.0",
  "identifier": "com.myaudit.app",
  "build": {
    "beforeDevCommand": "sh -c 'cd \"$(git rev-parse --show-toplevel)\" && make ui-check serve-restart && REAL_CLAUDE=1 PORT=7788 go run ./cmd/serve'",
    "devUrl": "http://localhost:7788",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "myAudit",
        "width": 1280,
        "height": 832,
        "visible": false,
        "url": "http://localhost:7788"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/myaudit-serve"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
